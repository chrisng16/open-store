# Backend environment example for local development
# Copy to backend/.env and replace placeholder values.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=

# Database / Redis
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/open_store
REDIS_URL=redis://localhost:6379/0
REDIS_SSL_CERT_REQS=required
REDIS_SSL_CA_CERTS=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PERCENT=5

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# App URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# Upload cleanup
UPLOAD_CLEANUP_MAX_AGE_HOURS=24
UPLOAD_CLEANUP_BATCH_SIZE=200

# Transactional email via SMTP (Brevo-compatible)
EMAIL_ENABLED=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15

# Verification and forgot-password emails remain managed by Supabase Auth.
# Configure Supabase Auth SMTP settings separately (use the same Brevo server if desired).
